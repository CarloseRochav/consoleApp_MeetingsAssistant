<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:themes="using:MeetingAssistant.App.Themes">

    <!--
        Misma paleta que DevLog (pizarra, índigo, rojo), en claro y oscuro.
        Las tarjetas van sobre Mica: el fondo de la ventana no se pinta.
        El índigo del botón es el mismo en los dos temas para que el texto blanco siga leyéndose.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#FF4F46E5</Color>

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF1E293B" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF475569" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF64748B" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF94A3B8" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4F46E5" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF6366F1" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF4338CA" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF4F46E5" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF6366F1" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF4338CA" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF4F46E5" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#FF6366F1" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#FF4338CA" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#FFE2E8F0" />

            <SolidColorBrush x:Key="AppHeadingBrush" Color="#FF1E293B" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#FF64748B" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#F7FFFFFF" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FFE2E8F0" />

            <SolidColorBrush x:Key="StatusWaitingForegroundBrush" Color="#FF475569" />
            <SolidColorBrush x:Key="StatusWaitingSurfaceBrush" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="StatusUploadingForegroundBrush" Color="#FF4338CA" />
            <SolidColorBrush x:Key="StatusUploadingSurfaceBrush" Color="#FFEEF2FF" />
            <SolidColorBrush x:Key="StatusProcessingForegroundBrush" Color="#FFB45309" />
            <SolidColorBrush x:Key="StatusProcessingSurfaceBrush" Color="#FFFFFBEB" />
            <SolidColorBrush x:Key="StatusReadyForegroundBrush" Color="#FF047857" />
            <SolidColorBrush x:Key="StatusReadySurfaceBrush" Color="#FFECFDF5" />
            <SolidColorBrush x:Key="StatusFailedForegroundBrush" Color="#FFB91C1C" />
            <SolidColorBrush x:Key="StatusFailedSurfaceBrush" Color="#FFFEF2F2" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="SystemAccentColor">#FF4F46E5</Color>

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFCBD5E1" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF64748B" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF4F46E5" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF818CF8" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF4338CA" />
            <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF334155" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#E6FFFFFF" />

            <SolidColorBrush x:Key="AccentButtonBackground" Color="#FF4F46E5" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#FF6366F1" />
            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#FF4338CA" />
            <SolidColorBrush x:Key="AccentButtonBackgroundDisabled" Color="#FF334155" />
            <SolidColorBrush x:Key="AccentButtonForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="AccentButtonForegroundDisabled" Color="#FF64748B" />
            <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="#FF4F46E5" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPointerOver" Color="#FF6366F1" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushPressed" Color="#FF4338CA" />
            <SolidColorBrush x:Key="AccentButtonBorderBrushDisabled" Color="#FF334155" />

            <SolidColorBrush x:Key="AppHeadingBrush" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="AppMutedBrush" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="AppCardBrush" Color="#EB0F172A" />
            <SolidColorBrush x:Key="AppCardBorderBrush" Color="#FF334155" />

            <SolidColorBrush x:Key="StatusWaitingForegroundBrush" Color="#FFCBD5E1" />
            <SolidColorBrush x:Key="StatusWaitingSurfaceBrush" Color="#FF1E293B" />
            <SolidColorBrush x:Key="StatusUploadingForegroundBrush" Color="#FFC7D2FE" />
            <SolidColorBrush x:Key="StatusUploadingSurfaceBrush" Color="#FF312E81" />
            <SolidColorBrush x:Key="StatusProcessingForegroundBrush" Color="#FFFCD34D" />
            <SolidColorBrush x:Key="StatusProcessingSurfaceBrush" Color="#FF451A03" />
            <SolidColorBrush x:Key="StatusReadyForegroundBrush" Color="#FF6EE7B7" />
            <SolidColorBrush x:Key="StatusReadySurfaceBrush" Color="#FF022C22" />
            <SolidColorBrush x:Key="StatusFailedForegroundBrush" Color="#FFFCA5A5" />
            <SolidColorBrush x:Key="StatusFailedSurfaceBrush" Color="#FF450A0A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <themes:StatusToneBrushConverter x:Key="StatusToneBrush" />
</ResourceDictionary>
