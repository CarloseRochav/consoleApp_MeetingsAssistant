<Page
    x:Class="MeetingAssistant.App.Views.RecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="720">
            <TextBlock Text="Grabar reunión" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Inicia la grabación y deténla cuando termine la reunión. El reporte se transcribirá, extraerá y guardará automáticamente."
                       TextWrapping="Wrap" />
            <Button Content="{Binding ButtonText}"
                    Command="{Binding ToggleRecordingCommand}"
                    HorizontalAlignment="Left"
                    MinWidth="180" />
            <Button Content="Procesar archivo existente"
                    Click="ProcessExistingAudio_Click"
                    HorizontalAlignment="Left"
                    MinWidth="180" />
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding ErrorDetails}"
                       TextWrapping="Wrap"
                       Foreground="DarkRed" />
            <TextBlock Text="{Binding LastSavedReportPath}" TextWrapping="Wrap" />
            <TextBlock Text="Transcripción" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox Text="{Binding LastTranscript, Mode=OneWay}"
                     AcceptsReturn="True"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MinHeight="240" />
        </StackPanel>
    </ScrollViewer>
</Page>
