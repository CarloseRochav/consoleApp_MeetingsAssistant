<Page
    x:Class="MeetingAssistant.App.Views.RecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    xmlns:vm="using:MeetingAssistant.App.ViewModels"
    mc:Ignorable="d">
    <Grid Padding="28,20,28,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Grabar" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyCopyStyle}" />
                <TextBlock Text="{Binding SessionText}" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="220">
                <Button Content="{Binding ButtonText}"
                        Command="{Binding ToggleRecordingCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Stretch" />
                <Button Content="Procesar audio existente"
                        Click="ProcessExistingAudio_Click"
                        IsEnabled="{Binding CanLoadExternalSource}"
                        HorizontalAlignment="Stretch" />
            </StackPanel>
        </Grid>

        <!-- Un camino, no una tarjeta por paso. El color del punto es el tono de esa fase. -->
        <Grid Grid.Row="1" ColumnSpacing="8" MinHeight="52">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="4"
                    Height="2"
                    Margin="18,5,18,0"
                    VerticalAlignment="Top"
                    Background="{ThemeResource AppCardBorderBrush}" />

            <StackPanel Spacing="6">
                <Ellipse Width="12" Height="12" HorizontalAlignment="Left"
                         Fill="{Binding RecordPhaseTone, Converter={StaticResource StatusToneBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="Grabar" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <Ellipse Width="12" Height="12" HorizontalAlignment="Left"
                         Fill="{Binding SendPhaseTone, Converter={StaticResource StatusToneBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="Enviar" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
                <Ellipse Width="12" Height="12" HorizontalAlignment="Left"
                         Fill="{Binding ServerPhaseTone, Converter={StaticResource StatusToneBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="Servidor" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="6">
                <Ellipse Width="12" Height="12" HorizontalAlignment="Left"
                         Fill="{Binding ReportPhaseTone, Converter={StaticResource StatusToneBrush}, ConverterParameter=Foreground}" />
                <TextBlock Text="Reporte" Style="{StaticResource CaptionTextStyle}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Reuniones" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Enviar ahora" Command="{Binding SendNowCommand}" />
                </Grid>
                <views:ErrorPanel Grid.Row="1" Details="{Binding ErrorDetails}" />
                <ListView x:Name="MeetingList"
                          Grid.Row="2"
                          ItemsSource="{Binding Meetings}"
                          SelectedItem="{Binding SelectedMeeting, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:QueueItemViewModel">
                            <Grid Padding="0,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    <Border Background="{Binding StatusTone, Converter={StaticResource StatusToneBrush}, ConverterParameter=Surface}"
                                            CornerRadius="10"
                                            Padding="8,2"
                                            HorizontalAlignment="Left">
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{Binding StatusTone, Converter={StaticResource StatusToneBrush}, ConverterParameter=Foreground}" />
                                    </Border>
                                    <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind IsUploading, Mode=OneWay}" />
                                    <TextBlock Text="{x:Bind Detail, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextStyle}"
                                               IsTextSelectionEnabled="True" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <Button Content="Abrir" Tag="{x:Bind}" Click="OpenReport_Click" Visibility="{x:Bind CanOpen, Mode=OneWay}" />
                                    <Button Content="Reintentar" Tag="{x:Bind}" Click="Retry_Click" Visibility="{x:Bind CanRetry, Mode=OneWay}" />
                                    <Button Content="Quitar" Tag="{x:Bind}" Click="Remove_Click" Visibility="{x:Bind CanRemove, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <Border Grid.Column="1" Width="1" Background="{ThemeResource AppCardBorderBrush}" />

            <Grid Grid.Column="2" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Reporte" Style="{StaticResource SectionTitleStyle}" />
                <TabView x:Name="ReportViewer"
                         Grid.Row="1"
                         IsAddTabButtonVisible="False"
                         TabWidthMode="SizeToContent"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch"
                         SelectionChanged="ReportViewer_SelectionChanged">
                    <TabViewItem Header="Vista previa" IsClosable="False"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                        <WebView2 x:Name="ReportPreview"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />
                    </TabViewItem>
                    <TabViewItem Header="Markdown" IsClosable="False"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                        <TextBox Text="{Binding LastGeneratedReport, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" />
                    </TabViewItem>
                </TabView>
            </Grid>
        </Grid>
    </Grid>
</Page>
