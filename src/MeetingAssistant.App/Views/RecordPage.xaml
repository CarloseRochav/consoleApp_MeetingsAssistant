<Page
    x:Class="MeetingAssistant.App.Views.RecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    xmlns:vm="using:MeetingAssistant.App.ViewModels"
    mc:Ignorable="d">
    <ScrollViewer Padding="32">
        <StackPanel Spacing="16" MaxWidth="880">
            <TextBlock Text="Grabar reunión" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Graba (o elige un audio existente) y la reunión se envía al servidor, que la transcribe y escribe el reporte. El .md llega al vault de Obsidian (carpeta MeetingReports). Sin conexión se graba igual: se envía después, también tras reiniciar."
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding SessionText}" TextWrapping="Wrap" Opacity="0.75" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding ButtonText}"
                        Command="{Binding ToggleRecordingCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="180" />
                <Button Content="Procesar audio existente"
                        Click="ProcessExistingAudio_Click"
                        IsEnabled="{Binding CanLoadExternalSource}"
                        MinWidth="180" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            <views:ErrorPanel Details="{Binding ErrorDetails}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Reuniones" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Enviar ahora" Command="{Binding SendNowCommand}" />
            </Grid>
            <TextBlock Text="Cada grabación pasa por: esperando → enviando → en el servidor → escribiendo el reporte → listo. Si algo pasajero lo frena (sin red, el tope diario), se dice por qué y se reintenta solo."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="12" />
            <ListView x:Name="MeetingList"
                      ItemsSource="{Binding Meetings}"
                      SelectedItem="{Binding SelectedMeeting, Mode=TwoWay}"
                      SelectionMode="Single"
                      MaxHeight="360">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueueItemViewModel">
                        <Grid Padding="0,8" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind Title, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                                <ProgressBar Value="{x:Bind Progress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind IsUploading, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Opacity="0.75" IsTextSelectionEnabled="True" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="Abrir" Tag="{x:Bind}" Click="OpenReport_Click" Visibility="{x:Bind CanOpen, Mode=OneWay}" />
                                <Button Content="Reintentar" Tag="{x:Bind}" Click="Retry_Click" Visibility="{x:Bind CanRetry, Mode=OneWay}" />
                                <Button Content="Quitar" Tag="{x:Bind}" Click="Remove_Click" Visibility="{x:Bind CanRemove, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock Text="Reporte" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="El de la reunión elegida en la lista, leído del .md del vault." Opacity="0.7" FontSize="12" />
            <TabView x:Name="ReportViewer"
                     IsAddTabButtonVisible="False"
                     TabWidthMode="SizeToContent"
                     MinHeight="420"
                     SelectionChanged="ReportViewer_SelectionChanged">
                <TabViewItem Header="Vista previa" IsClosable="False">
                    <WebView2 x:Name="ReportPreview"
                              MinHeight="380"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
                </TabViewItem>
                <TabViewItem Header="Markdown" IsClosable="False">
                    <TextBox Text="{Binding LastGeneratedReport, Mode=OneWay}"
                             AcceptsReturn="True"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MinHeight="380"
                             FontFamily="Consolas" />
                </TabViewItem>
            </TabView>
        </StackPanel>
    </ScrollViewer>
</Page>
