<Page
    x:Class="MeetingAssistant.App.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    xmlns:vm="using:MeetingAssistant.App.ViewModels"
    mc:Ignorable="d">

    <!--
        Maestro-detalle en una sola página. La barra no tiene atrás y el Frame
        navega sin parámetro, así que el detalle no es otra página. La re-extracción queda fija abajo: es la acción principal.
        Si algo "no aparece" en UIA, medir ActualWidth/ActualHeight antes de
        tocar el XAML: UIA no expone esta sección y ya se reestructuró una vez
        por esa señal falsa.
    -->
    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="0" Background="Transparent" BorderThickness="0">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Historial"
                           Style="{StaticResource PageTitleStyle}" />

                <StackPanel Grid.Row="1" Spacing="8">
                    <Button Content="Actualizar"
                            Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Left"
                            MinWidth="140" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Style="{StaticResource CaptionTextStyle}" />
                    <ProgressBar x:Name="LoadingBar"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                    <views:ErrorPanel Details="{Binding ErrorDetails}" />
                    <TextBox Header="Buscar en las transcripciones"
                             PlaceholderText="Una palabra que se dijo en la reunión"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTipService.ToolTip="Busca por comienzo de palabra: «factura» encuentra «facturación». Los acentos no importan. Si escribes varias palabras, tienen que aparecer todas." />
                    <TextBlock Text="{Binding SearchSummary}"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <ListView Grid.Row="2"
                          ItemsSource="{Binding Sessions}"
                          SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionListItem">
                            <StackPanel Padding="0,8" Spacing="2">
                                <TextBlock Text="{x:Bind Title}"
                                           TextWrapping="Wrap"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Subtitle}"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Text="{x:Bind Snippet, Mode=OneWay}"
                                           Visibility="{x:Bind HasSnippet, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           FontStyle="Italic"
                                           FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Spacing="8"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock Text="Todavía no hay reuniones"
                               Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Graba una reunión desde la pestaña Grabar, con el atajo Ctrl+Alt+F9, o desde la bandeja. Aparecerá acá en cuanto termine."
                               Style="{StaticResource BodyCopyStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="DetailPanel"
                Grid.Column="1"
                Padding="8,0,0,0"
                BorderBrush="{ThemeResource AppCardBorderBrush}"
                BorderThickness="1,0,0,0"
                Background="Transparent"
                Visibility="Collapsed">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="{Binding SelectedSession.Title}"
                               Style="{StaticResource SectionTitleStyle}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedSession.Subtitle}"
                               Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>

                <Expander Grid.Row="1"
                          Header="Transcripción"
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding TranscriptDetails}"
                                   Style="{StaticResource CaptionTextStyle}" />
                        <TextBox Text="{Binding Transcript, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Height="140" />
                    </StackPanel>
                </Expander>

                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="Reportes de esta reunión"
                               Style="{StaticResource SectionTitleStyle}" />
                    <ListView ItemsSource="{Binding Reports}"
                              SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                              SelectionMode="Single"
                              Height="110"
                              Background="Transparent"
                              BorderThickness="0">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReportListItem">
                                <StackPanel Padding="0,6" Spacing="2">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{x:Bind Subtitle}"
                                               Style="{StaticResource CaptionTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button Content="Guardar este reporte en el vault"
                            Command="{Binding SaveToVaultCommand}"
                            ToolTipService.ToolTip="Escribe el .md en el vault (por ejemplo, el de una reunión grabada en el teléfono)."
                            HorizontalAlignment="Left"
                            MinWidth="220" />
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="6">
                    <TextBlock Text="Audio" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding AudioHint}" Style="{StaticResource CaptionTextStyle}" />
                    <Button Content="Escuchar" Command="{Binding ListenCommand}" HorizontalAlignment="Left" MinWidth="140" />
                    <MediaPlayerElement x:Name="AudioPlayer" AreTransportControlsEnabled="True" Height="80" Visibility="Collapsed" />
                </StackPanel>

                <TabView x:Name="ReportViewer"
                         Grid.Row="4"
                         IsAddTabButtonVisible="False"
                         TabWidthMode="SizeToContent"
                         MinHeight="220"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch"
                         SelectionChanged="ReportViewer_SelectionChanged">
                    <TabViewItem Header="Vista previa" IsClosable="False"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                        <WebView2 x:Name="ReportPreview"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" />
                    </TabViewItem>
                    <TabViewItem Header="Markdown" IsClosable="False"
                                 HorizontalContentAlignment="Stretch"
                                 VerticalContentAlignment="Stretch">
                        <TextBox Text="{Binding SelectedReportMarkdown, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" />
                    </TabViewItem>
                </TabView>

                <StackPanel Grid.Row="5" Spacing="8">
                    <TextBlock Text="Volver a extraer con otro prompt"
                               Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{Binding RegenerateHint}"
                               Style="{StaticResource CaptionTextStyle}" />
                    <ComboBox Header="Catálogo"
                              ItemsSource="{Binding Prompts}"
                              SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding SelectedPromptDescription}"
                               Style="{StaticResource CaptionTextStyle}" />
                    <Expander Header="Ver el texto del prompt" HorizontalAlignment="Stretch">
                        <TextBox Text="{Binding SelectedPromptText, Mode=OneWay}"
                                 AcceptsReturn="True"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Height="160"
                                 FontFamily="Consolas" />
                    </Expander>
                    <Button Content="Generar reporte nuevo"
                            Command="{Binding RegenerateReportCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            MinWidth="220" />
                    <ProgressBar x:Name="BusyBar"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
