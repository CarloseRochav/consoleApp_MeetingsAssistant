<Window
    x:Class="MeetingAssistant.App.Views.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    Title="Meeting Assistant — first-time setup"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer>
        <Border
            MaxWidth="640"
            Margin="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="16">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="First-time setup" />
                <TextBlock
                    Style="{StaticResource BodyCopyStyle}"
                    Text="This install is missing values for this machine (where to write the reports). There are no provider keys to type: the app talks to the DevLog server, and you sign in with your user afterwards." />

                <InfoBar
                    x:Name="MissingInfo"
                    Title="Missing"
                    IsClosable="False"
                    IsOpen="True"
                    Severity="Warning" />

                <views:SettingsForm x:Name="Form" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
