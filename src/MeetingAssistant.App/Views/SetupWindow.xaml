<Window
    x:Class="MeetingAssistant.App.Views.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    Title="Meeting Assistant — configuración inicial"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer>
        <StackPanel
            MaxWidth="640"
            Margin="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="16">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Configuración inicial" />
            <TextBlock
                MaxWidth="600"
                TextWrapping="Wrap"
                Text="A esta instalación le faltan valores para poder grabar. Las claves no viajan dentro del instalador: se escriben acá una vez por máquina y se guardan cifradas para tu usuario de Windows." />

            <InfoBar
                x:Name="MissingInfo"
                Title="Falta"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning" />

            <TextBlock
                MaxWidth="600"
                Opacity="0.75"
                TextWrapping="Wrap"
                Text="Si usas la nube, pega primero la cadena de Postgres: el proveedor, el modelo y los precios llegan de ahí al reiniciar, y esta ventana vuelve a aparecer sólo si todavía falta algo." />

            <views:SettingsForm x:Name="Form" />
        </StackPanel>
    </ScrollViewer>
</Window>
