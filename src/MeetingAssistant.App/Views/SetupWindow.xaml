<Window
    x:Class="MeetingAssistant.App.Views.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    Title="Meeting Assistant — configuración inicial"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer>
        <StackPanel
            MaxWidth="640"
            Margin="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="16">

            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Configuración inicial" />
            <TextBlock
                MaxWidth="600"
                TextWrapping="Wrap"
                Text="A esta instalación le faltan valores de esta máquina (dónde escribir los reportes). No hay claves de proveedor que escribir: la app habla con el servidor de DevLog, y después se inicia sesión con tu usuario." />

            <InfoBar
                x:Name="MissingInfo"
                Title="Falta"
                IsClosable="False"
                IsOpen="True"
                Severity="Warning" />

            <views:SettingsForm x:Name="Form" />
        </StackPanel>
    </ScrollViewer>
</Window>
