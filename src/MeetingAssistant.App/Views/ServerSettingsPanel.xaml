<UserControl
    x:Class="MeetingAssistant.App.Views.ServerSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:MeetingAssistant.App.ViewModels"
    xmlns:views="using:MeetingAssistant.App.Views"
    mc:Ignorable="d">
    <StackPanel Spacing="12">
        <TextBlock MaxWidth="600"
                   Opacity="0.75"
                   TextWrapping="Wrap"
                   Text="Tus ajustes en el servidor, para todos tus dispositivos (también el teléfono). Vacío = vale el de la base compartida. Las claves de los proveedores y los precios no se ven ni se cambian aquí: son del servidor." />
        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ServerSettingItem">
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                        <TextBox Header="{x:Bind Label}"
                                 Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="{x:Bind Placeholder}" />
                        <TextBlock Text="{x:Bind Hint}" TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Guardar en el servidor" Command="{Binding SaveCommand}" Style="{StaticResource AccentButtonStyle}" />
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" MaxWidth="600" Opacity="0.8" />
        <views:ErrorPanel Details="{Binding ErrorDetails}" />
    </StackPanel>
</UserControl>
