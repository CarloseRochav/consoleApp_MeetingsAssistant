<UserControl
    x:Class="MeetingAssistant.App.Views.SettingsForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    mc:Ignorable="d">
    <!--
        Los ajustes de ESTA máquina. Lo usan dos lugares: la página de Configuración y la ventana de
        primer arranque. Desde el paso B no hay claves de proveedor ni cadenas de conexión: la app
        habla sólo con la API de DevLog.
    -->
    <StackPanel Spacing="16">

        <!-- Vault -->
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Obsidian vault" />
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="VaultPathBox"
                     Header="Vault folder"
                     PlaceholderText="C:\path\to\your\vault"
                     TextChanged="VaultPathBox_TextChanged" />
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Click="BrowseVaultButton_Click"
                    Content="Browse..." />
        </Grid>
        <TextBlock x:Name="VaultPathStatusText" MaxWidth="600" Opacity="0.75" TextWrapping="Wrap" />
        <TextBox x:Name="SubFolderBox"
                 Header="Subfolder for the reports"
                 PlaceholderText="MeetingReports" />

        <Expander Header="Advanced" HorizontalAlignment="Stretch" Margin="0,8,0,0">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Local HTTP endpoint" />
                <PasswordBox x:Name="ApiTokenBox"
                             Header="Token (X-Api-Token header)"
                             PlaceholderText="empty = a new one is generated on restart" />
            </StackPanel>
        </Expander>

        <!-- Guardar -->
        <Button x:Name="SaveButton"
                Margin="0,16,0,0"
                Click="SaveButton_Click"
                Content="Save changes"
                Style="{StaticResource PrimaryButtonStyle}" />
        <TextBlock x:Name="SaveStatusText" MaxWidth="600" Opacity="0.75" TextWrapping="Wrap" />
        <views:ErrorPanel x:Name="SaveErrorPanel" />

        <!-- Lo que quedó del modo local (antes del paso B) -->
        <StackPanel x:Name="LeftoverPanel" Spacing="8" Visibility="Collapsed">
            <TextBlock x:Name="LeftoverText" MaxWidth="600" TextWrapping="Wrap" />
            <Button x:Name="DeleteLeftoverButton"
                    Click="DeleteLeftoverButton_Click"
                    Content="Delete this machine's old keys" />
        </StackPanel>

        <TextBlock x:Name="SettingsFilePathText"
                   MaxWidth="600"
                   FontSize="12"
                   IsTextSelectionEnabled="True"
                   Opacity="0.5"
                   TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
