<Page
    x:Class="MeetingAssistant.App.Views.CostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    xmlns:vm="using:MeetingAssistant.App.ViewModels"
    mc:Ignorable="d">

    <!--
        Página propia y no una sección de Historial. Sin gráficos a propósito:
        con decenas de reuniones, el total y la tabla dicen lo que hay que decir.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="16" MaxWidth="760" HorizontalAlignment="Center">

            <TextBlock Text="Costos" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="Los calcula el servidor con sus precios (tokens y minutos de audio), para tus reuniones de todos los dispositivos. Son estimaciones: no se compararon con ninguna factura. Un precio desconocido nunca se cuenta como 0."
                       Style="{StaticResource BodyCopyStyle}" />

            <StackPanel Spacing="8">
                <Button Content="Actualizar"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Left"
                        MinWidth="140" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextStyle}" />
                <views:ErrorPanel Details="{Binding ErrorDetails}" />
                <ProgressBar x:Name="LoadingBar"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="EmptyStatePanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Todavía no hay nada que sumar"
                           Style="{StaticResource SectionTitleStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Los costos aparecen cuando una reunión llega a tener transcripción o reporte. Graba una desde la pestaña Grabar, con el atajo Ctrl+Alt+F9, o desde la bandeja."
                           Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>

            <StackPanel x:Name="DataPanel" Spacing="16" Visibility="Collapsed">

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding TotalLabel}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding TotalCostText}" Style="{StaticResource HeroFigureStyle}" />

                        <Grid ColumnSpacing="24" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="LLM (reportes)" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LlmCostText}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Transcripción" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TranscriptionCostText}" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding PeriodText}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="CaveatsPanel" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Lo que estos números no incluyen"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding Caveats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource BodyCopyStyle}"
                                               Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Por mes" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding MonthRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CostMonthRow">
                                    <StackPanel Padding="0,10,0,10"
                                                Spacing="2"
                                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                        <TextBlock Text="{x:Bind Title}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Details}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
