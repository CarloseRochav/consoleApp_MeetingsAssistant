<Page
    x:Class="MeetingAssistant.App.Views.CostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    xmlns:vm="using:MeetingAssistant.App.ViewModels"
    mc:Ignorable="d">

    <!--
        Página propia y no una sección de Historial. Sin gráficos a propósito:
        con decenas de reuniones, el total y la tabla dicen lo que hay que decir.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32" Spacing="16" MaxWidth="760" HorizontalAlignment="Center">

            <TextBlock Text="Costs" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="The server calculates these from its prices (tokens and minutes of audio), for your meetings on every device. They are estimates: they were not compared with any invoice. An unknown price is never counted as 0."
                       Style="{StaticResource BodyCopyStyle}" />

            <StackPanel Spacing="8">
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Left"
                        MinWidth="140" />
                <TextBlock Text="{Binding StatusMessage}"
                           Style="{StaticResource CaptionTextStyle}" />
                <views:ErrorPanel Details="{Binding ErrorDetails}" />
                <ProgressBar x:Name="LoadingBar"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </StackPanel>

            <StackPanel x:Name="EmptyStatePanel" Spacing="8" Visibility="Collapsed">
                <TextBlock Text="Nothing to add up yet"
                           Style="{StaticResource SectionTitleStyle}"
                           TextWrapping="Wrap" />
                <TextBlock Text="Costs appear when a meeting gets a transcript or a report. Record one from the Record page, with the Ctrl+Alt+F9 shortcut, or from the tray."
                           Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>

            <StackPanel x:Name="DataPanel" Spacing="16" Visibility="Collapsed">

                <Border Padding="0" Background="Transparent" BorderThickness="0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding TotalLabel}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding TotalCostText}" Style="{StaticResource HeroFigureStyle}" />

                        <Grid ColumnSpacing="24" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="LLM (reports)" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LlmCostText}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Transcription" Style="{StaticResource CaptionTextStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TranscriptionCostText}" TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock Text="{Binding AverageText}" Style="{StaticResource CaptionTextStyle}" />
                        <TextBlock Text="{Binding PeriodText}" Style="{StaticResource CaptionTextStyle}" />
                    </StackPanel>
                </Border>

                <Border x:Name="CaveatsPanel" Background="Transparent" BorderThickness="0" Padding="0" Visibility="Collapsed">
                    <StackPanel Spacing="6">
                        <TextBlock Text="What these numbers leave out"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding Caveats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}"
                                               Style="{StaticResource BodyCopyStyle}"
                                               Margin="0,0,0,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Padding="0" Background="Transparent" BorderThickness="0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="By month" Style="{StaticResource SectionTitleStyle}" />
                        <ItemsControl ItemsSource="{Binding MonthRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CostMonthRow">
                                    <StackPanel Padding="0,10,0,10"
                                                Spacing="2"
                                                BorderBrush="{ThemeResource AppCardBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                        <TextBlock Text="{x:Bind Title}"
                                                   TextWrapping="Wrap"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Details}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
