<Window
    x:Class="MeetingAssistant.App.Views.SignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Meeting Assistant — sign in"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Border MaxWidth="440"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="14">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Sign in" />
                <TextBlock Style="{StaticResource BodyCopyStyle}"
                           Text="Your DevLog user, once on this machine. The server transcribes and writes the report." />

                <InfoBar x:Name="ReasonInfo" IsClosable="False" IsOpen="False" Severity="Warning" />

                <TextBox x:Name="UsernameBox" Header="Username" />
                <PasswordBox x:Name="PasswordBox" Header="Password" KeyDown="PasswordBox_KeyDown" />
                <TextBlock x:Name="DeviceText" Style="{StaticResource CaptionTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButtonStyle}" Click="SignInButton_Click" />
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                </StackPanel>
                <TextBlock x:Name="ResultText" Style="{StaticResource BodyCopyStyle}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="This machine gets its own token, encrypted for your Windows user. The password is not stored." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
