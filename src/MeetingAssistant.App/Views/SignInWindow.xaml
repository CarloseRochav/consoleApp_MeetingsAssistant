<Window
    x:Class="MeetingAssistant.App.Views.SignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Meeting Assistant — iniciar sesión"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Border MaxWidth="440"
                Margin="32"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="14">
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Iniciar sesión" />
                <TextBlock Style="{StaticResource BodyCopyStyle}"
                           Text="Tu usuario de DevLog, una vez en esta máquina. El servidor transcribe y escribe el reporte." />

                <InfoBar x:Name="ReasonInfo" IsClosable="False" IsOpen="False" Severity="Warning" />

                <TextBox x:Name="UsernameBox" Header="Usuario" />
                <PasswordBox x:Name="PasswordBox" Header="Contraseña" KeyDown="PasswordBox_KeyDown" />
                <TextBlock x:Name="DeviceText" Style="{StaticResource CaptionTextStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SignInButton" Content="Iniciar sesión" Style="{StaticResource PrimaryButtonStyle}" Click="SignInButton_Click" />
                    <ProgressRing x:Name="Busy" IsActive="False" Width="20" Height="20" />
                </StackPanel>
                <TextBlock x:Name="ResultText" Style="{StaticResource BodyCopyStyle}" />
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="Esta máquina recibe su propio token, cifrado para tu usuario de Windows. La contraseña no se guarda." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
