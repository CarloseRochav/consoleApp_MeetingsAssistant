<Page
    x:Class="MeetingAssistant.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="32">
        <StackPanel
            MaxWidth="560"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="16">
            <TextBlock Text="Configuración" Style="{StaticResource TitleTextBlockStyle}" />
            <ToggleSwitch
                x:Name="StartupToggle"
                Header="Iniciar con Windows"
                Toggled="StartupToggle_Toggled" />
            <TextBlock
                x:Name="StartupStatusText"
                MaxWidth="520"
                Opacity="0.75"
                Text="Consultando el estado configurado en Windows..."
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
