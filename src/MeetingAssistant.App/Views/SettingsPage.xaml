<Page
    x:Class="MeetingAssistant.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel
            MaxWidth="640"
            Margin="32"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Spacing="16">

            <TextBlock Text="Configuración" Style="{StaticResource TitleTextBlockStyle}" />

            <!-- Inicio automático (T5) -->
            <ToggleSwitch
                x:Name="StartupToggle"
                Header="Iniciar con Windows"
                Toggled="StartupToggle_Toggled" />
            <TextBlock
                x:Name="StartupStatusText"
                MaxWidth="600"
                Opacity="0.75"
                Text="Consultando el estado configurado en Windows..."
                TextWrapping="Wrap" />

            <!-- Los ajustes, compartidos con la ventana de primer arranque. -->
            <views:SettingsForm x:Name="Form" Margin="0,16,0,0" />

            <TextBlock
                MaxWidth="600"
                Margin="0,8,0,0"
                Opacity="0.6"
                TextWrapping="Wrap"
                Text="Los cambios se aplican al reiniciar la app: los clientes de audio, transcripción y LLM se construyen una sola vez al arrancar. El inicio automático es la excepción y se aplica al instante." />

            <!--
                Prompts. Van al final y con sus propios botones: no los guarda el
                "Guardar cambios" de arriba, y a diferencia del resto de esta
                página se aplican al instante, sin reiniciar.
            -->
            <TextBlock
                Margin="0,24,0,0"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="Prompts" />
            <views:PromptEditorPanel x:Name="PromptEditor" />
        </StackPanel>
    </ScrollViewer>
</Page>
