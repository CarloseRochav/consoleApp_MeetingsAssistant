<Page
    x:Class="MeetingAssistant.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel
            MaxWidth="720"
            Margin="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Spacing="28">

            <TextBlock Text="Configuración" Style="{StaticResource PageTitleStyle}" />

            <Border Padding="0" Background="Transparent" BorderThickness="0">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Cuenta y dispositivo" />
                    <TextBlock x:Name="DeviceText" Style="{StaticResource BodyCopyStyle}" />
                    <Button x:Name="SignOutButton" Content="Cerrar sesión en esta máquina" Click="SignOutButton_Click" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}"
                               Text="Cerrar sesión borra el token de esta máquina; en el servidor sigue valiendo hasta revocarlo en DevLog (Devices). Lo grabado y pendiente queda en la cola y se envía al volver a iniciar sesión." />
                </StackPanel>
            </Border>

            <Border Padding="0" Background="Transparent" BorderThickness="0">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Inicio" />
                    <ToggleSwitch
                        x:Name="StartupToggle"
                        Header="Iniciar con Windows"
                        Toggled="StartupToggle_Toggled" />
                    <TextBlock
                        x:Name="StartupStatusText"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Consultando el estado configurado en Windows..." />
                </StackPanel>
            </Border>

            <Border Padding="0" Background="Transparent" BorderThickness="0">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Esta máquina" />
                    <views:SettingsForm x:Name="Form" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Los ajustes de esta máquina se aplican al reiniciar la app. El inicio automático y los ajustes del servidor se aplican al instante." />
                </StackPanel>
            </Border>

            <Border Padding="0" Background="Transparent" BorderThickness="0">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="En el servidor" />
                    <views:ServerSettingsPanel x:Name="ServerSettings" />
                </StackPanel>
            </Border>

            <Border Padding="0" Background="Transparent" BorderThickness="0">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Prompts" />
                    <views:PromptEditorPanel x:Name="PromptEditor" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
