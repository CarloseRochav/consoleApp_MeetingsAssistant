<Page
    x:Class="MeetingAssistant.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MeetingAssistant.App.Views"
    mc:Ignorable="d">
    <Grid Margin="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

        <SelectorBar x:Name="SectionBar" Grid.Row="1" SelectionChanged="SectionBar_SelectionChanged">
            <SelectorBarItem Text="Account" IsSelected="True" />
            <SelectorBarItem Text="This machine" />
            <SelectorBarItem Text="Server" />
            <SelectorBarItem Text="Prompts" />
        </SelectorBar>

        <ScrollViewer Grid.Row="2">
            <Grid MaxWidth="720" HorizontalAlignment="Stretch">
                <StackPanel x:Name="AccountPanel" Spacing="28">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Account and device" />
                        <TextBlock x:Name="DeviceText" Style="{StaticResource BodyCopyStyle}" />
                        <Button x:Name="SignOutButton" Content="Sign out on this machine" Click="SignOutButton_Click" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}"
                                   Text="Signing out deletes the token on this machine. It stays valid on the server until you revoke it in DevLog (Devices). What is recorded and still waiting stays in the queue and is sent when you sign in again." />
                    </StackPanel>
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Startup" />
                        <ToggleSwitch
                            x:Name="StartupToggle"
                            Header="Start with Windows"
                            Toggled="StartupToggle_Toggled" />
                        <TextBlock
                            x:Name="StartupStatusText"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="Checking the startup state configured in Windows..." />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="MachinePanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="This machine" />
                    <views:SettingsForm x:Name="Form" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Text="Settings for this machine apply when you restart the app. Startup and the server settings apply at once." />
                </StackPanel>

                <StackPanel x:Name="ServerPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="On the server" />
                    <views:ServerSettingsPanel x:Name="ServerSettings" />
                </StackPanel>

                <StackPanel x:Name="PromptsPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Prompts" />
                    <views:PromptEditorPanel x:Name="PromptEditor" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
