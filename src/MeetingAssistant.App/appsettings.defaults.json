{
  "//": "Valores de fabrica SIN secretos. Es lo unico que viaja en el paquete para instalar; esta en git. Las claves y cadenas de conexion se escriben en Configuracion, una vez por maquina.",
  "Llm": {
    "Provider": "Gemini"
  },
  "Configuration": {
    "Source": "Local"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "AzureStorage": {
    "AudioContainer": "meeting-audio",
    "ReportsContainer": "meeting-reports",
    "LocalAudioRetentionDays": 0
  },
  "Storage": {
    "SubFolder": "MeetingReports"
  },
  "Api": {
    "Port": 5757
  },
  "Hotkey": {
    "Modifiers": "Control+Alt",
    "Key": "F9"
  }
}
